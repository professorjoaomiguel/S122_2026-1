    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -150,
      "left": -150,
      "attrs": {}
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 100,
